@page "/admin/products"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Env
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject ApplicationDbContext Db

<h3>Admin - Produkter</h3>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="text-success">@message</p>
}

<h4>Lägg till / redigera produkt</h4>

@if (isEditing)
{
    <p class="text-warning">
        Du redigerar nu produkten: @productForm.Name
    </p>
}

<div class="mb-3">
    <label>Namn</label>
    <input class="form-control" @bind="productForm.Name" />
</div>

<div class="mb-3">
    <label>Beskrivning</label>
    <textarea class="form-control" @bind="productForm.Description"></textarea>
</div>

<div class="mb-3">
    <label>Pris</label>
    <input class="form-control" type="number" step="0.01" @bind="productForm.Price" />
</div>

<div class="mb-3">
    <label>Kategori</label>
    <select class="form-control" @bind="productForm.Category">
        <option value="">Välj kategori</option>
        <option value="Smycken">Smycken</option>
        <option value="Heminredning">Heminredning</option>
        <option value="Väskor">Väskor</option>
    </select>
</div>

<div class="mb-3">
    <label>Bilder</label>
    <InputFile OnChange="HandleImageUpload" multiple />
</div>

<div class="mb-3">
    <label>Färger / varianter</label>
    <input class="form-control" @bind="variantsInput" placeholder="Röd, Blå, Grön" />
</div>

<button class="btn btn-primary" @onclick="SaveProduct">
    @(isEditing ? "Spara ändringar" : "Lägg till produkt")
</button>

@if (isEditing)
{
    <button class="btn btn-secondary ms-2" @onclick="CancelEdit">Avbryt</button>
}

<hr />

<h4>Produkter</h4>

@if (products == null)
{
    <p>Laddar produkter...</p>
}
else if (!products.Any())
{
    <p>Inga produkter finns ännu.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Namn</th>
                <th>Kategori</th>
                <th>Beskrivning</th>
                <th>Pris</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Category</td>
                    <td>@product.Description</td>
                    <td>@product.Price kr</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => EditProduct(product)">
                            Redigera
                        </button>

                        <button class="btn btn-sm btn-danger ms-2" @onclick="() => DeleteProduct(product.Id)">
                            Ta bort
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? products;
    private Product productForm = new();
    private bool isEditing = false;
    private IReadOnlyList<IBrowserFile> selectedImages = new List<IBrowserFile>();
    private string variantsInput = string.Empty;
    private string? message;

    private void HandleImageUpload(InputFileChangeEventArgs e)
    {
        selectedImages = e.GetMultipleFiles();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await Db.Products
            .Include(p => p.Images)
            .Include(p => p.Variants)
            .ToListAsync();
    }

    private async Task SaveProduct()
    {
        Product? product;

        if (isEditing)
        {
            product = await Db.Products
                .Include(p => p.Images)
                .Include(p => p.Variants)
                .FirstOrDefaultAsync(p => p.Id == productForm.Id);

            if (product == null)
            {
                return;
            }

            product.Name = productForm.Name;
            product.Description = productForm.Description;
            product.Price = productForm.Price;
            product.Category = productForm.Category;
        }
        else
        {
            product = new Product
            {
                Name = productForm.Name,
                Description = productForm.Description,
                Price = productForm.Price,
                Category = productForm.Category
            };

            Db.Products.Add(product);
            await Db.SaveChangesAsync();
        }

        foreach (var image in selectedImages)
        {
            var fileExtension = Path.GetExtension(image.Name);
            var fileName = $"{Guid.NewGuid()}{fileExtension}";
            var folderPath = Path.Combine(Env.WebRootPath, "uploads", "products");

            if (!Directory.Exists(folderPath))
            {
                Directory.CreateDirectory(folderPath);
            }

            var filePath = Path.Combine(folderPath, fileName);

            await using var stream = new FileStream(filePath, FileMode.Create);
            await image.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(stream);

            Db.ProductImages.Add(new ProductImage
            {
                ProductId = product.Id,
                ImageUrl = $"/uploads/products/{fileName}"
            });
        }

        if (!string.IsNullOrWhiteSpace(variantsInput))
        {
            if (isEditing)
            {
                Db.ProductVariants.RemoveRange(product.Variants);
            }

            var colors = variantsInput
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(c => c.Trim())
                .ToList();

            foreach (var color in colors)
            {
                Db.ProductVariants.Add(new ProductVariant
                {
                    ProductId = product.Id,
                    Color = color
                });
            }
        }

        await Db.SaveChangesAsync();

        message = isEditing ? "Produkten uppdaterades." : "Produkten lades till.";

        productForm = new Product();
        selectedImages = new List<IBrowserFile>();
        variantsInput = string.Empty;
        isEditing = false;

        await LoadProducts();
    }

    private void EditProduct(Product product)
    {
        productForm = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            Category = product.Category
        };

        variantsInput = string.Join(", ", product.Variants.Select(v => v.Color));

        isEditing = true;
    }

    private async Task DeleteProduct(int id)
    {
        var product = await Db.Products.FindAsync(id);

        if (product != null)
        {
            Db.Products.Remove(product);
            await Db.SaveChangesAsync();
            await LoadProducts();
        }
    }

    private void CancelEdit()
    {
        productForm = new Product();
        isEditing = false;
    }
}
