@page "/"

<div class="home-page">

    <div class="top-banner">
        Fri frakt inom Sverige vid köp över 1000 kr
    </div>

    <section class="hero-section">
        <div class="hero-text">
            <img src="/images/logo/logo.jpeg" alt="Design by Tjäder" class="hero-logo" />

            <p class="hero-subtitle">Samisk design med en modern touch</p>

            <h1>Handgjorda samiska produkter</h1>

            <p class="hero-description">
                Välkommen till Design by Tjäder. Här hittar du handgjorda samiska produkter
                såsom smycken, heminredning och väskor.
            </p>

            <div class="hero-buttons">
                <a href="/products" class="btn-main">Se produkter</a>
            </div>

            <div class="hero-info-boxes">
                <div class="info-box">Handgjort</div>
                <div class="info-box">Samisk design</div>
                <div class="info-box">Unika produkter</div>
            </div>
        </div>

        <div class="hero-image-wrapper">
            <img src="/images/home/hero.jpeg" alt="Hero-bild" class="hero-image" />
        </div>
    </section>

    <section class="categories-section">
        <div class="section-heading">
            <h2>Utforska sortimentet</h2>
            <p>Välj bland olika typer av produkter i butiken.</p>
        </div>

        <div class="category-grid">
            <div class="category-card">
                <h3>Smycken</h3>
                <p>Handgjorda armband, ringar, örhängen och halsband med samisk design.</p>
                <a href="/products" class="category-link">Visa produkter</a>
            </div>

            <div class="category-card">
                <h3>Heminredning</h3>
                <p>Handgjorda grytlappar och ljusstakar för hemmet.</p>
                <a href="/products" class="category-link">Visa produkter</a>
            </div>

            <div class="category-card">
                <h3>Väskor</h3>
                <p>Handgjorda samiska väskor med en modern touch.</p>
                <a href="/products" class="category-link">Visa produkter</a>
            </div>
        </div>
    </section>

</div>
