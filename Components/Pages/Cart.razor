@page "/cart"
@rendermode InteractiveServer
@inject CartService CartService
@inject ApplicationDbContext Db

<div class="page-container">
    <div class="section-title">
        <h2>Kundvagn</h2>
        <p>Kontrollera dina produkter innan du går vidare.</p>
    </div>

    <div class="cart-box">
        @if (CartService.Items == null || !CartService.Items.Any())
        {
            <p>Din kundvagn är tom.</p>
            <a class="btn-main" href="/products">Till produkter</a>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Produkt</th>
                        <th>Variant</th>
                        <th>Pris</th>
                        <th>Antal</th>
                        <th>Totalt</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in CartService.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@(item.SelectedColor ?? "-")</td>
                            <td>@item.Price kr</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => Decrease(item.ProductId)">-</button>
                                <span class="mx-2">@item.Quantity</span>
                                <button class="btn btn-sm btn-secondary" @onclick="() => Increase(item.ProductId)">+</button>
                            </td>
                            <td>@item.TotalPrice kr</td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="() => Remove(item.ProductId)">
                                    Ta bort
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <h4>Totalpris: @CartService.GetTotalPrice() kr</h4>

            <button class="btn btn-outline-danger" @onclick="ClearCart">
                Töm kundvagn
            </button>

            <button class="btn-main ms-2" @onclick="Checkout">
                Gå till betalning
            </button>
        }
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CartService.LoadCartAsync();
            StateHasChanged();
        }
    }

    private async Task Increase(int productId)
    {
        await CartService.IncreaseQuantityAsync(productId);
    }

    private async Task Decrease(int productId)
    {
        await CartService.DecreaseQuantityAsync(productId);
    }

    private async Task Remove(int productId)
    {
        await CartService.RemoveFromCartAsync(productId);
    }

    private async Task ClearCart()
    {
        await CartService.ClearCartAsync();
    }
}
@code {
    private async Task Checkout()
    {
        var order = new Order
        {
            TotalPrice = CartService.GetTotalPrice(),
            Status = "Pending"
        };

        Db.Orders.Add(order);
        await Db.SaveChangesAsync();

        foreach (var item in CartService.Items)
        {
            Db.OrderItems.Add(new OrderItem
            {
                OrderId = order.Id,
                ProductName = item.ProductName,
                Price = item.Price,
                Quantity = item.Quantity,
                SelectedColor = item.SelectedColor
            });
        }

        await Db.SaveChangesAsync();

        await CartService.ClearCartAsync();

        // SENARE:
        // redirect till Stripe / Swish / Klarna
    }
}
