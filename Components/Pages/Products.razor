@page "/products"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject CartService CartService

<div class="page-container">
    <div class="section-title">
        <h2>Produkter</h2>
        <p>Här visas tillgängliga produkter.</p>
    </div>

    <div class="mb-4">
        <button class="btn btn-outline-dark me-2" @onclick='() => selectedCategory = "Alla"'>
            Alla
        </button>

        <button class="btn btn-outline-dark me-2" @onclick='() => selectedCategory = "Smycken"'>
            Smycken
        </button>

        <button class="btn btn-outline-dark me-2" @onclick='() => selectedCategory = "Heminredning"'>
            Heminredning
        </button>

        <button class="btn btn-outline-dark me-2" @onclick='() => selectedCategory = "Väskor"'>
            Väskor
        </button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="text-success">@message</p>
    }

    @if (products == null)
    {
        <p>Laddar produkter...</p>
    }
    else if (!products.Any())
    {
        <p>Inga produkter hittades.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in FilteredProducts)
            {
                <div class="product-card">
                    @if (product.Images.Any())
                    {
                        var firstImage = product.Images.First();

                        <img src="@firstImage.ImageUrl" alt="@product.Name" />

                        @if (product.Images.Count > 1)
                        {
                            <div class="product-thumbnails">
                                @foreach (var image in product.Images.Skip(1).Take(4))
                                {
                                    <img src="@image.ImageUrl" alt="@product.Name" />
                                }
                            </div>
                        }
                    }

                    <h4>@product.Name</h4>

                    <p><strong>Kategori:</strong> @product.Category</p>

                    <p>@product.Description</p>

                    <p class="product-price">@product.Price kr</p>

                    @if (product.Variants.Any())
                    {
                        <div class="mb-3">
                            <label>Välj variant:</label>
                            <select class="form-control" @bind="selectedColors[product.Id]">
                                @foreach (var variant in product.Variants)
                                {
                                    <option value="@variant.Color">@variant.Color</option>
                                }
                            </select>
                        </div>
                    }

                    <button class="btn-main" @onclick="() => AddToCart(product)">
                        Lägg i kundvagn
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Product>? products;
    private string? message;
    private Dictionary<int, string?> selectedColors = new();

    private string selectedCategory = "Alla";

    private IEnumerable<Product> FilteredProducts =>
    selectedCategory == "Alla"
        ? products ?? Enumerable.Empty<Product>()
        : products?.Where(p => p.Category == selectedCategory) ?? Enumerable.Empty<Product>();

    protected override async Task OnInitializedAsync()
    {
        products = await Db.Products
            .Include(p => p.Images)
            .Include(p => p.Variants)
            .ToListAsync();

        foreach (var product in products)
        {
            selectedColors[product.Id] = product.Variants.FirstOrDefault()?.Color;
        }
    }

    private async Task AddToCart(Product product)
    {
        selectedColors.TryGetValue(product.Id, out var selectedColor);

        await CartService.AddToCartAsync(product, selectedColor);

        message = $"{product.Name} lades till i kundvagnen.";
    }
}