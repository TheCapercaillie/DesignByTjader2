@page "/products"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject CartService CartService

<div class="products-page">

    <div class="products-header">
        <h2>Produkter</h2>
        <p>Utforska handgjorda produkter med inspiration från samisk tradition och natur.</p>
    </div>

    <div class="category-filter">
        <button class="@(selectedCategory == "Alla" ? "active" : "")" @onclick='() => selectedCategory = "Alla"'>
            Alla
        </button>

        <button class="@(selectedCategory == "Smycken" ? "active" : "")" @onclick='() => selectedCategory = "Smycken"'>
            Smycken
        </button>

        <button class="@(selectedCategory == "Heminredning" ? "active" : "")" @onclick='() => selectedCategory = "Heminredning"'>
            Heminredning
        </button>

        <button class="@(selectedCategory == "Väskor" ? "active" : "")" @onclick='() => selectedCategory = "Väskor"'>
            Väskor
        </button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="cart-toast" @key="toastKey">
            <span>✓ @message</span>

            @if (addedQuantity > 1)
            {
                <span class="cart-toast-count">x@(addedQuantity)</span>
            }

            <a href="/cart" class="cart-toast-link">Visa kundvagn</a>
        </div>
    }

    @if (products == null)
    {
        <p>Laddar produkter...</p>
    }
    else if (!FilteredProducts.Any())
    {
        <p>Inga produkter hittades i denna kategori.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in FilteredProducts)
            {
                <div class="product-card">

                    @{
                        var images = product.Images
                            .GroupBy(i => i.ImageUrl)
                            .Select(g => g.First())
                            .OrderBy(i => i.SortOrder)
                            .ThenBy(i => i.Id)
                            .ToList();

                        var mainImage = images.FirstOrDefault();
                        var thumbnails = images.Skip(1).Take(9).ToList();
                    }

                    <a href="/product/@product.Id" class="product-link">
                        @if (mainImage != null)
                        {
                            <img src="@mainImage.ImageUrl"
                                 alt="@product.Name"
                                 class="product-main-image" />
                        }
                        else
                        {
                            <div class="product-main-image"></div>
                        }
                    </a>

                    @if (thumbnails.Any())
                    {
                        <div class="product-thumbnails">
                            @foreach (var image in thumbnails)
                            {
                                <img src="@image.ImageUrl"
                                     alt="@product.Name"
                                     class="product-thumbnail" />
                            }
                        </div>
                    }

                    <div class="product-card-content">
                        <div class="product-category">@product.Category</div>

                        <a href="/product/@product.Id" class="product-link">
                            <h4>@product.Name</h4>
                        </a>

                        <p class="product-description">@product.Description</p>

                        <div class="product-price">@product.Price kr</div>

                        @if (product.Variants.Any())
                        {
                            <div class="variant-select">
                                <label>Välj variant</label>
                                <select @bind="selectedColors[product.Id]">
                                    @foreach (var variant in product.Variants)
                                    {
                                        <option value="@variant.Color">@variant.Color</option>
                                    }
                                </select>
                            </div>
                        }

                        <button class="btn-main add-cart-btn" @onclick="() => AddToCart(product)">
                            Lägg i kundvagn
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Product>? products;
    private string? message;
    private Dictionary<int, string?> selectedColors = new();
    private int addedQuantity;
    private int toastKey;
    private CancellationTokenSource? toastCts;

    private string selectedCategory = "Alla";

    private IEnumerable<Product> FilteredProducts =>
        selectedCategory == "Alla"
            ? products ?? Enumerable.Empty<Product>()
            : products?.Where(p => p.Category == selectedCategory) ?? Enumerable.Empty<Product>();

    protected override async Task OnInitializedAsync()
    {
        products = await Db.Products
            .Include(p => p.Images)
            .Include(p => p.Variants)
            .ToListAsync();

        foreach (var product in products)
        {
            selectedColors[product.Id] = product.Variants.FirstOrDefault()?.Color;
        }
    }

    private async Task AddToCart(Product product)
    {
        selectedColors.TryGetValue(product.Id, out var selectedColor);

        await CartService.AddToCartAsync(product, selectedColor);

        addedQuantity = CartService.Items
            .FirstOrDefault(i => i.ProductId == product.Id && i.SelectedColor == selectedColor)?.Quantity ?? 1;

        message = $"{product.Name} lades till i kundvagnen.";
        toastKey++;
        StateHasChanged();

        await HideToastAfterDelay();
    }

    private async Task HideToastAfterDelay()
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;

        try
        {
            await Task.Delay(3500, token);
            message = null;
        }
        catch (TaskCanceledException)
        {
            // En ny produkt lades till, den nya timern tar över
        }
    }
}