@page "/products"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject CartService CartService

<h3>Smycken</h3>

@if (!string.IsNullOrEmpty(message))
{
    <p class="text-success">@message</p>
}
@if (products == null)
{
    <p>Laddar produkter...</p>
}
else if (!products.Any())
{
    <p>Inga produkter hittades.</p>
}
else
{
    foreach (var product in products)
    {
        <div style="border:1px solid #ccc; padding:15px; margin-bottom:15px; border-radius:8px;">
            <h4>@product.Name</h4>
            <p>@product.Description</p>
            <p><strong>Pris:</strong> @product.Price kr</p>

            @if (product.Images.Any())
            {
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:10px;">
                    @foreach (var image in product.Images)
                    {
                        <img src="@image.ImageUrl" alt="@product.Name" width="140" style="border-radius:8px;" />
                    }
                </div>
            }

            @if (product.Variants.Any())
            {
                <div class="mb-3">
                    <label>Välj färg:</label>
                    <select class="form-control" @bind="selectedColors[product.Id]">
                        @foreach (var variant in product.Variants)
                        {
                            <option value="@variant.Color">@variant.Color</option>
                        }
                    </select>
                </div>
            }

            <button class="btn btn-primary" @onclick="() => AddToCart(product)">
                Lägg i kundvagn
            </button>
        </div>
    }
}

@code {
    private List<Product>? products;
    private string? message;
    private Dictionary<int, string?> selectedColors = new();

    protected override async Task OnInitializedAsync()
    {
        products = await Db.Products
            .Include(p => p.Images)
            .Include(p => p.Variants)
            .ToListAsync();

        foreach (var product in products)
        {
            selectedColors[product.Id] = product.Variants.FirstOrDefault()?.Color;
        }
    }

    private async Task AddToCart(Product product)
    {
        selectedColors.TryGetValue(product.Id, out var selectedColor);

        await CartService.AddToCartAsync(product, selectedColor);

        message = $"{product.Name} lades till i kundvagnen.";
    }
}