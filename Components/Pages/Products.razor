@page "/products"
@rendermode InteractiveServer
@using DesignByTjader.Services
@using DesignByTjader.Data
@using DesignByTjader.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject CartService CartService

<h3>Smycken</h3>

@if (!string.IsNullOrEmpty(message))
{
    <p class="text-success">@message</p>
}
@if (products == null)
{
    <p>Laddar produkter...</p>
}
else if (!products.Any())
{
    <p>Inga produkter hittades.</p>
}
else
{
    foreach (var product in products)
    {
        <div style="border:1px solid #ccc; padding:15px; margin-bottom:15px; border-radius:8px;">
            <h4>@product.Name</h4>
            <p>@product.Description</p>
            <p><strong>Pris:</strong> @product.Price kr</p>

            <button class="btn btn-primary" @onclick="() => AddToCart(product)">
                Lägg i kundvagn
            </button>

            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
            {
                <img src="@product.ImageUrl" alt="@product.Name" width="200" />
            }
        </div>
    }
}

@code {
    private List<Product>? products;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        products = await Db.Products.ToListAsync();
    }

    private async Task AddToCart(Product product)
    {
        await CartService.AddToCartAsync(product);
        message = $"{product.Name} lades till i kundvagnen.";
    }
}